# Server Configuration
PORT=8080
GIN_MODE=debug

# Database Configuration
# Default is zero-setup SQLite (no Docker or external database required):
DB_DRIVER=sqlite
DATABASE_URL=calorie_calculator.db

# If using PostgreSQL:
# DB_DRIVER=postgres
# DATABASE_URL=host=localhost user=postgres password=postgres dbname=calorie_calculator port=5432 sslmode=disable

# Security
JWT_SECRET=calorie-calculator-super-secret-key-replace-in-production

